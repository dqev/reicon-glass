{
  "name": "reicon-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@reicon/web run dev",
    "build": "npm --workspace=@reicon/web run build",
    "build:all": "npm --workspace=@reicon/web run build:all",
    "build:icons": "npm --workspace=@reicon/web run build:icons",
    "build:assets": "npm --workspace=@reicon/web run build:assets",
    "lint": "oxlint",
    "preview": "npm --workspace=@reicon/web run preview"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
