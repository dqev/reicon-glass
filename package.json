{
  "name": "reicon-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@reicon/web run dev",
    "build": "npm run build --workspaces --if-present",
    "generate:assets": "node tools/generate-assets.cjs",
    "lint": "oxlint",
    "preview": "npm --workspace=@reicon/web run preview"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
