{
  "name": "reicon-agent",
  "version": "0.0.3",
  "type": "module",
  "sideEffects": false,
  "description": "Agentic Reicon core package — 1100+ curated rounded icons built for AI Coding Agents & developers.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn/reicon.js",
  "jsdelivr": "./dist/cdn/reicon.js",
  "browser": "./dist/cdn/reicon.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons/*": {
      "import": "./dist/icons/*.js",
      "types": "./dist/icons/*.d.ts"
    },
    "./createIcon": {
      "import": "./dist/createIcon.js",
      "types": "./dist/createIcon.d.ts"
    },
    "./umd/reicon.js": {
      "import": "./dist/umd/reicon-agent.js"
    },
    "./cdn/reicon.js": {
      "import": "./dist/cdn/reicon.js"
    },
    "./cdn/*": {
      "import": "./dist/cdn/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "publish:dist": "npm run build && npm publish ./dist --access public"
  },
  "keywords": [
    "reicon",
    "reicon-agent",
    "ai-agent",
    "agentic-icons",
    "web-components",
    "svg-icons",
    "icon-library"
  ],
  "author": "devchauhan <dev@devchauhan.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dqev/reicon-agent.git"
  },
  "bugs": {
    "url": "https://github.com/dqev/reicon-agent/issues"
  },
  "homepage": "https://agent.reicon.dev"
}
